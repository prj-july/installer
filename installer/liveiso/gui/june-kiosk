#!/bin/bash
# Graphical installer on tty1: cage (a Wayland kiosk compositor) running cog
# (WPE WebKit) fullscreen on the local backend.  Falls back to the text menu
# when the graphics stack cannot start, or when the user picks "Switch to the
# text installer" in the GUI (the backend writes /run/june-ui-mode).
set -u

URL="http://127.0.0.1/"
MODE_FILE=/run/june-ui-mode
LOG=/tmp/june-kiosk.log

# cage/wlroots needs a private runtime dir.  When the kiosk is started as root
# from the login shell (see /etc/profile.d/zz-june-menu.sh) there is no user
# runtime dir, and without one cage exits with "XDG_RUNTIME_DIR is not set".
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/june-kiosk}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

# This image has no logind seat; cage/session access goes through seatd, which
# the live-config component 0040-june-seat authorises for the live user.
export LIBSEAT_BACKEND=seatd

text_menu() {
  persist_log
  clear
  exec /usr/local/bin/june-menu
}

# Leave the kiosk log on the boot USB so a failed graphical start can be
# inspected from a normal machine later.
persist_log() {
  local mnt
  mnt="$(bash /opt/june-installer/backup.sh ventoy-dir 2>/dev/null || true)"
  [ -n "$mnt" ] || return 0
  mkdir -p "$mnt/june-logs" 2>/dev/null || return 0
  cp -f "$LOG" "$mnt/june-logs/june-kiosk.log" 2>/dev/null || return 0
  sync 2>/dev/null || true
}

if ! command -v cage >/dev/null 2>&1 || ! command -v cog >/dev/null 2>&1; then
  echo "cage/cog not installed; starting the text installer." >>"$LOG"
  text_menu
fi

# Keep kernel messages off the screen while graphics start.
sudo -n dmesg -n 1 2>/dev/null || true

echo "Starting the graphical installer..."
for _ in $(seq 1 40); do
  (exec 3<>/dev/tcp/127.0.0.1/80) 2>/dev/null && break
  sleep 0.5
done

# GPU rendering first; pixman (software) for machines whose GPU driver or
# firmware is missing.  A session that dies within 15 s counts as a failed
# start and moves to the next renderer; after the last one, use the text menu.
renderers=(auto pixman)
r=0
while :; do
  [ "$(cat "$MODE_FILE" 2>/dev/null)" = "text" ] && text_menu
  if [ "${renderers[$r]}" = "auto" ]; then
    unset WLR_RENDERER
  else
    export WLR_RENDERER="${renderers[$r]}"
    export WLR_RENDERER_ALLOW_SOFTWARE=1
  fi
  echo "=== $(date '+%F %T') cage (renderer ${renderers[$r]})" >>"$LOG"
  pkill -x cage 2>/dev/null || true
  rm -f "$XDG_RUNTIME_DIR/wayland-0" "$XDG_RUNTIME_DIR/wayland-0.lock" 2>/dev/null || true
  start="$(date +%s)"
  cage -d -s -- cog --platform=wl "$URL" >>"$LOG" 2>&1 &
  cage_pid=$!

  # Startup watchdog: cage must publish its Wayland socket within 20 s.  A
  # failed seat/libseat handshake used to leave cage running forever, which
  # kept the whole installer on the console with no text-menu fallback.
  socket_ok=0
  for _ in $(seq 1 40); do
    if [ -S "$XDG_RUNTIME_DIR/wayland-0" ]; then
      socket_ok=1
      break
    fi
    kill -0 "$cage_pid" 2>/dev/null || break
    sleep 0.5
  done
  # The socket only means the compositor came up; the web view (cog) must be
  # alive too, otherwise the screen would stay black forever.
  if [ "$socket_ok" = "1" ]; then
    cog_ok=0
    for _ in $(seq 1 30); do
      if pgrep -x cog >/dev/null 2>&1; then
        cog_ok=1
        break
      fi
      kill -0 "$cage_pid" 2>/dev/null || break
      sleep 0.5
    done
    if [ "$cog_ok" != "1" ]; then
      echo "=== cog did not start within 15s; treating the renderer as failed" >>"$LOG"
      socket_ok=0
    fi
  fi
  if [ "$socket_ok" != "1" ]; then
    echo "=== cage watchdog: no Wayland socket after 20s; killing $cage_pid" >>"$LOG"
    kill "$cage_pid" 2>/dev/null || true
    sleep 1
    kill -9 "$cage_pid" 2>/dev/null || true
  fi
  persist_log
  wait "$cage_pid" 2>/dev/null
  rc=$?
  echo "=== cage exited with $rc" >>"$LOG"
  [ "$(cat "$MODE_FILE" 2>/dev/null)" = "text" ] && text_menu
  if [ "$socket_ok" != "1" ] || [ $(( $(date +%s) - start )) -lt 15 ]; then
    r=$((r + 1))
    if [ "$r" -ge "${#renderers[@]}" ]; then
      echo "Graphics did not start (details in $LOG); using the text installer." >&2
      sleep 2
      text_menu
    fi
  fi
  sleep 1
done
