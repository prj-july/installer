[Unit]
Description=June Local graphical installer backend
# The text-mode boot entry passes june.ui=text and never needs it.
ConditionKernelCommandLine=!june.ui=text
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/june-installer/gui/server.py --port 80 --payload /opt/june-installer
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
