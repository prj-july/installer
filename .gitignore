# Generated payload and images
installer/liveiso/assets/
*.iso
*.iso.sha256

# Blobs and secrets: never commit
*.apk
# Our own tiny light-bridge helper is source-built and belongs in the payload;
# all June-licensed APKs remain ignored.
!onoven/oven-light/OvenLight_signed.apk
# apktool intermediate build tree for the JuneDns helper
onoven/june-dns/build/
*.p12
*.jks
*.keystore
*.key
*.key.bak*
*.pem
*junelife_chain*.crt
# generate_certs.sh output (CA and leaf private keys) and CA scratch
certs/
ca-tmp/
*.img
*.bct
*.bin
upstream-content/
# Local build blobs (RCM firmware/tools supplied outside the repo)
june-rcm/
# Go build output (built with make oven / make camerad)
golocal/bin/
installer/backup/june-backup

# CIFS silly-rename artifacts (files deleted while still open on the NAS)
.__smbfile*

# Python caches and virtualenvs
__pycache__/
*.pyc
.venv/
